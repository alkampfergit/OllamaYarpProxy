{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information", 
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Yarp": "Debug",
        "OllamaYarpProject": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ReverseProxy": {
    "Routes": {
      "ollama": {
        "ClusterId": "ollamaCluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ollamaCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://192.168.64.2:4000/"
          }
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:11434"
      }
    }
  },
  "O3ProConfig": {
    "Endpoint": "https://api.override.com",
    "ApiKey": "override-api-key",
    "DeploymentName": "o3-pro-override"
  }
}